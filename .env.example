# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required: Gemini API key — powers the agent loop, router, entity extraction, and vision
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Computer Navigation Agent — uses Gemini Flash + browser-use (MIT) + pyautogui
# No extra API key needed: GEMINI_API_KEY above already covers the nav agent vision loop.
# Browser tasks (Gmail, GitHub, Notion …) use browser-use + Gemini Flash.
# Desktop tasks (native apps) use Gemini vision loop + pyautogui.
# Setup: pip install browser-use && playwright install chromium
# VISION_MODEL=models/gemini-2.0-flash     # nav agent vision model (free tier)
# NAV_MAX_ITER=20                           (max perceive-act iterations per task)

# MCP servers — Model Context Protocol integrations
# Copy mcp_servers.json.example to mcp_servers.json and configure your servers.
# Each server is a subprocess; CollectiveOS connects at startup and exposes its tools.
# Requires Node.js for npx-based MCP servers.
# MCP_SERVERS_CONFIG=/path/to/custom/mcp_servers.json   # optional override

# Postgres connection (defaults to docker-compose.yml credentials if not set)
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant

# Redis (optional but recommended for multi-worker deployments)
# Tool results and chat status are cached here; falls back to in-process dict if unset.
# REDIS_URL=redis://localhost:6379/0

# LangSmith observability — traces every Gemini call and tool execution
# Sign up free at https://smith.langchain.com, create a project, copy the API key.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=collectiveos

# Model overrides (all default to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_PLANNER_MODEL=gemini-3.6-flash  # task orchestrator planner
# GEMINI_ROUTER_MODEL=gemini-2.0-flash-lite  # intent classifier — keep this cheap
# GRAPH_MODEL=gemini-3.6-flash      # entity extraction in graph_memory.py
# VISION_MODEL=gemini-3.6-flash     # nav agent vision
# EMBED_MODEL=gemini-embedding-001  # memory embeddings (3072 dims)

# Optional: single-user auth token for the FastAPI layer
# API_TOKEN=your-secret-token-here

# Telegram bot — used for proactive routine/watcher notifications
# 1. Message @BotFather → /newbot → copy the token below
# 2. Start a chat with your bot, send any message, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → copy your chat_id
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_WEBHOOK_SECRET=your-random-secret

# Home Assistant
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-token  (Profile → Security → Long-Lived Access Tokens)

# Your local timezone (IANA format). Default is UTC if not set.
# TIMEZONE=America/Toronto

# Spotify (for music playback control across all Spotify Connect devices)
# 1. Create a free app at https://developer.spotify.com/dashboard
# 2. Add redirect URI: http://localhost:8888/callback
# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_CLIENT_SECRET=your-client-secret
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Health data — Oura Ring (optional; if unset, uses iOS Shortcuts bridge instead)
# OURA_TOKEN=...
# iOS Shortcuts bridge: POST /health-ingest with:
#   {"date": "YYYY-MM-DD", "source": "apple_health",
#    "metrics": {"steps": 8000, "sleep_hours": 7.5, "hrv": 45,
#                "resting_heart_rate": 58, "active_calories": 400}}

# Car — Tesla (select brand in Settings ⚙ → Car, or set CAR_BRAND=tesla here)
# TESLA_TOKEN=your-tesla-fleet-api-token
# TESLA_VEHICLE_ID=       (optional; defaults to first vehicle on the account)
# TESLA_FLEET_BASE_URL=   (optional; defaults to NA region)
# BMW/MINI: CAR_BRAND=bmw  BMW_USERNAME=...  BMW_PASSWORD=...  BMW_VIN=...
# Ford/Lincoln: CAR_BRAND=ford  FORD_USERNAME=...  FORD_PASSWORD=...
# CAR_BRAND=tesla

# iOS Push Notifications via APNs
# APNS_KEY_ID=ABCDE12345               # 10-char key ID from Apple Developer
# APNS_TEAM_ID=FGHIJ67890              # 10-char team ID
# APNS_AUTH_KEY_PATH=/path/to/AuthKey_ABCDE12345.p8
# APNS_BUNDLE_ID=com.yourname.collectiveos
# APNS_DEVICE_TOKEN=0a1b2c3d...        # 64-char hex from your iOS app
# APNS_SANDBOX=1                       # 1 for dev/TestFlight; omit for production

# Smart Appliances — Samsung SmartThings (select brand in Settings ⚙ → Smart Appliances)
# SMARTTHINGS_TOKEN=your-smartthings-token
# LG ThinQ: APPLIANCE_BRAND=lgthinq  LG_USERNAME=...  LG_PASSWORD=...  LG_COUNTRY=US
# APPLIANCE_BRAND=smartthings

# Robot — ROS2 MCP server (leave unset to use stub/simulation mode)
# ROS2_MCP_URL=http://localhost:9090
